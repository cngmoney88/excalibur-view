<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The office server and shared tool chests. Nothing else:
         drawings come in through the system's own pickers and "open with",
         never through a permission to read all of storage. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- AndroidX adds this one to every app that uses it, for receivers it
         registers on Android 12 and older. It is the app's own permission and
         grants nothing, but it reads as a third on the store page, and the
         system's broadcasts reach those receivers without it. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- OpenGL ES 3 is the fallback when a phone's Vulkan driver cannot draw
         the window. Every phone with Vulkan has it, so this excludes nothing
         that could have run the app. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ExcaliburView"
        android:appCategory="productivity"
        android:resizeableActivity="true"
        android:supportsRtl="true">

        <!-- One window, handling its own configuration changes. The program
             runs on a thread Android does not own, and winit cannot build a
             second window in the same process, so the activity must never be
             torn down and recreated for a rotation, a fold, a keyboard or a
             theme change, and there must never be two of it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|touchscreen|uiMode|fontScale|locale|layoutDirection|colorMode|mcc|mnc">

            <!-- The Rust library GameActivity loads and starts:
                 libexcalibur_view_mobile.so, from crates/mobile. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="excalibur_view_mobile" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with Excalibur View" for a PDF, from a file manager, a
                 mail attachment or a download. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Excalibur View in the share sheet, for one PDF or several. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Lends a drawing or an export to the app it is shared with, for as
             long as that app needs it, without a permission on storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
